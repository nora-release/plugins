{
  "apiVersion": 2,
  "id": "trae-cn",
  "name": "Trae CN",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "https://trae-api-cn.mchost.guru/v1",
      "authMethods": [
        {
          "id": "oauth",
          "type": "oauth",
          "label": "Sign in with Trae CN"
        },
        {
          "id": "oauth-client",
          "type": "oauth",
          "label": "Sign in and use this Trae CN installation for daily credits",
          "prompts": [
            {
              "key": "path",
              "type": "text",
              "label": "Trae CN storage file (optional)",
              "placeholder": "…/User/globalStorage/storage.json"
            }
          ]
        }
      ],
      "config": {
        "authTimeoutMs": 600000,
        "accountActions": [
          "checkin"
        ],
        "initialResponseTimeoutMs": 240000,
        "accountAutomation": {
          "version": 1,
          "checkin": {
            "method": "checkin",
            "statusMethod": "checkinStatus",
            "timeZone": "Asia/Shanghai",
            "authMethods": [
              "oauth",
              "oauth-client"
            ]
          }
        }
      }
    }
  }
}
