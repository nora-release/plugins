{
  "apiVersion": 2,
  "id": "azure-openai-responses",
  "name": "Azure OpenAI Responses",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "azure-openai-responses",
      "baseURL": "https://YOUR-RESOURCE.openai.azure.com",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "API key",
              "required": true
            }
          ]
        }
      ],
      "config": {
        "modelMetadata": true,
        "connectionOptions": true,
        "catalog": "azure",
        "keyProvider": "azure-openai-responses",
        "providerOptions": {
          "apiVersion": "2024-10-21"
        },
        "legacy": {
          "providerID": "azure-openai-responses",
          "keyProvider": "azure-openai-responses",
          "oauthProvider": null,
          "credentialProvider": "apiKey"
        }
      }
    }
  }
}
