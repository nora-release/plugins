{
  "apiVersion": 1,
  "id": "word-guard",
  "name": "Word Guard",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "gateway-middleware",
  "authMethods": [],
  "models": [],
  "config": {
    "gatewayMiddleware": {
      "version": 1,
      "request": true,
      "event": true,
      "response": true
    },
    "middlewareOptions": {
      "words": [
        "project-codename"
      ],
      "patterns": [],
      "action": "reject",
      "check": "last"
    },
    "description": "Reject or mask configured words and patterns in requests and replies."
  }
}
