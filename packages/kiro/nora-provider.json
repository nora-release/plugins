{
  "apiVersion": 1,
  "id": "kiro",
  "name": "Kiro",
  "version": "1.1.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "anthropic-messages",
  "baseURL": "https://runtime.us-east-1.kiro.dev",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with Google, GitHub, AWS Builder ID or IAM Identity Center"
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "Kiro API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "label": "Kiro API key (ksk_\u2026)",
          "type": "password",
          "required": true
        }
      ]
    },
    {
      "id": "cliSource",
      "type": "oauth",
      "label": "Use a selected Kiro CLI account database",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Kiro CLI data.sqlite3 path",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "id": "ideSource",
      "type": "oauth",
      "label": "Use a selected Kiro IDE account file",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Kiro IDE kiro-auth-token.json path",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "models": [
    {
      "id": "auto",
      "name": "Auto",
      "reasoning": true
    }
  ],
  "config": {
    "catalog": "",
    "keyProvider": "kiro",
    "oauthProvider": "kiro",
    "description": "Connect Kiro with Google, GitHub, AWS Builder ID, IAM Identity Center, an API key, or an explicitly selected read-only CLI/IDE account source."
  }
}
