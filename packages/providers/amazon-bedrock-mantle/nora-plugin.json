{
  "apiVersion": 2,
  "id": "amazon-bedrock-mantle",
  "name": "Amazon Bedrock (Mantle)",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "us-east-1",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "Bedrock API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "Bedrock API key",
              "required": true
            },
            {
              "id": "region",
              "key": "region",
              "type": "text",
              "label": "AWS region",
              "placeholder": "us-east-1"
            }
          ]
        }
      ],
      "config": {
        "keyProvider": "amazon-bedrock-mantle",
        "catalog": "amazon-bedrock",
        "connectionManaged": true,
        "modelDiscovery": {
          "noList": false
        },
        "endpointKind": "region"
      }
    }
  }
}
