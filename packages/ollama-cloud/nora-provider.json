{
  "apiVersion": 1,
  "id": "ollama-cloud",
  "name": "Ollama Cloud",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://ollama.com/v1",
  "authMethods": [
    {
      "id": "apiKey",
      "type": "api",
      "label": "API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "API key",
          "required": true
        }
      ]
    }
  ],
  "models": [
    {
      "id": "deepseek-v4-flash",
      "name": "deepseek-v4-flash"
    },
    {
      "id": "deepseek-v4-pro",
      "name": "deepseek-v4-pro"
    }
  ],
  "config": {
    "catalog": "ollama-cloud",
    "keyProvider": "ollama-cloud",
    "modelDiscovery": {
      "defaultBaseURL": "https://ollama.com/v1",
      "bases": [
        {
          "api": "openai-completions",
          "baseURL": "https://ollama.com/v1"
        }
      ]
    }
  }
}
