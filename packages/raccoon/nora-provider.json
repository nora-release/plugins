{
  "apiVersion": 1,
  "id": "raccoon",
  "name": "Raccoon",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://xiaohuanxiong.com/api/web/llm/v2",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Raccoon account"
    },
    {
      "id": "manual",
      "type": "oauth",
      "label": "Paste a Raccoon callback or token"
    },
    {
      "id": "desktop",
      "type": "source",
      "label": "Use selected Raccoon desktop account",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Raccoon account file",
          "type": "text",
          "required": true,
          "placeholder": "~/.box-agent/config/auth.json"
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "persistent": true,
    "accountActions": [
      "checkin"
    ],
    "authTimeoutMs": 600000
  }
}
