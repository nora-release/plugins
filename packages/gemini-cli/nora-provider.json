{
  "apiVersion": 1,
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "version": "1.1.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "google-generative-ai",
  "baseURL": "https://cloudcode-pa.googleapis.com",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in to Gemini CLI",
      "fields": [
        {
          "id": "project",
          "key": "project",
          "type": "text",
          "label": "Google Cloud project (if required)",
          "required": false
        }
      ]
    },
    {
      "id": "source",
      "type": "oauth",
      "label": "Use an explicitly selected Google account file",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "type": "text",
          "label": "Account JSON file path",
          "required": true
        },
        {
          "id": "project",
          "key": "project",
          "type": "text",
          "label": "Google Cloud project (if required)",
          "required": false
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "catalog": "",
    "keyProvider": "gemini-cli",
    "oauthProvider": "gemini-cli",
    "description": "Connect Gemini CLI with Google sign-in or an explicitly selected read-only account file.",
    "modelDiscovery": {
      "defaultBaseURL": "https://cloudcode-pa.googleapis.com",
      "bases": [
        {
          "api": "google-generative-ai",
          "baseURL": "https://cloudcode-pa.googleapis.com"
        }
      ]
    }
  }
}
