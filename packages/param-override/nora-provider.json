{
  "apiVersion": 1,
  "id": "param-override",
  "name": "Param Override",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "gateway-middleware",
  "authMethods": [],
  "models": [],
  "config": {
    "gatewayMiddleware": {
      "version": 1,
      "request": true
    },
    "middlewareOptions": {
      "operations": [
        {
          "path": "max_tokens",
          "mode": "set",
          "value": 32000,
          "conditions": [
            {
              "path": "max_tokens",
              "mode": "gt",
              "value": 32000
            }
          ]
        },
        {
          "path": "temperature",
          "mode": "delete",
          "conditions": [
            {
              "path": "model",
              "mode": "contains",
              "value": "reasoner"
            }
          ]
        }
      ]
    },
    "description": "Set, delete, move or rewrite request fields with optional conditions."
  }
}
