{
  "apiVersion": 1,
  "id": "github-copilot",
  "name": "GitHub Copilot",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://api.individual.githubcopilot.com",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in"
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "API key",
          "required": true
        }
      ]
    },
    {
      "id": "copilotEditors",
      "type": "source",
      "label": "Use the Copilot editors’ sign-in"
    }
  ],
  "models": [
    {
      "id": "oswe-vscode-prime",
      "name": "Raptor mini (Preview)",
      "reasoning": true,
      "input": [
        "text"
      ],
      "contextWindow": 256000,
      "maxTokens": 64000
    }
  ],
  "config": {
    "sourceAuthMethods": [
      {
        "id": "copilotEditors",
        "type": "source",
        "label": "Use the Copilot editors’ sign-in"
      }
    ],
    "catalog": "github-copilot",
    "keyProvider": "github-copilot",
    "oauthProvider": "github-copilot",
    "legacy": {
      "providerID": "github-copilot",
      "keyProvider": "github-copilot",
      "oauthProvider": "github-copilot",
      "credentialProvider": "gitHubCopilot"
    }
  },
  "localSignIns": [
    {
      "method": "copilotEditors",
      "label": "GitHub Copilot",
      "paths": [
        "~/.config/github-copilot/apps.json"
      ]
    }
  ]
}
