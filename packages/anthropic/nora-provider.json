{
  "apiVersion": 1,
  "id": "anthropic",
  "name": "Anthropic",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "anthropic-messages",
  "baseURL": "https://api.anthropic.com",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with installed Claude Code",
      "fields": [
        {
          "id": "claudePath",
          "key": "claudePath",
          "type": "text",
          "label": "Claude Code executable path (optional)",
          "required": false
        }
      ]
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "API key",
          "required": true
        }
      ]
    },
    {
      "id": "claudeCode",
      "type": "source",
      "label": "Use Claude Code’s sign-in"
    }
  ],
  "models": [],
  "config": {
    "catalog": "anthropic",
    "keyProvider": "anthropic-api-key",
    "oauthProvider": "anthropic",
    "legacy": {
      "providerID": "anthropic",
      "keyProvider": "anthropic-api-key",
      "oauthProvider": "anthropic",
      "credentialProvider": "anthropic"
    },
    "description": "Claude subscriptions use the installed Claude Code in an isolated account profile; API keys use Anthropic HTTP directly.",
    "headerHints": [
      "anthropic-workspace-id"
    ]
  },
  "localSignIns": [
    {
      "method": "claudeCode",
      "label": "Claude Code",
      "keychain": "Claude Code-credentials",
      "paths": [
        "~/.claude/.credentials.json"
      ]
    }
  ]
}
