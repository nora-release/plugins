{
  "apiVersion": 2,
  "id": "zhipu",
  "name": "Zhipu GLM",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "https://open.bigmodel.cn/api/paas/v4",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "Pay as you go",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "API key",
              "required": true
            }
          ]
        },
        {
          "id": "profile-coding",
          "type": "api",
          "label": "Coding Plan",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "API key",
              "required": true
            }
          ]
        }
      ],
      "config": {
        "modelMetadata": true,
        "connectionOptions": true,
        "catalog": "zhipuai",
        "keyProvider": "zhipu",
        "modelDiscovery": {
          "defaultBaseURL": "https://open.bigmodel.cn/api/paas/v4",
          "bases": [
            {
              "api": "openai-completions",
              "baseURL": "https://open.bigmodel.cn/api/paas/v4"
            },
            {
              "api": "anthropic-messages",
              "baseURL": "https://open.bigmodel.cn/api/anthropic"
            }
          ],
          "noList": false
        },
        "legacyProfile": "coding",
        "profiles": [
          {
            "id": "api",
            "name": "Pay as you go",
            "bases": [
              {
                "api": "openai-completions",
                "baseURL": "https://open.bigmodel.cn/api/paas/v4"
              },
              {
                "api": "anthropic-messages",
                "baseURL": "https://open.bigmodel.cn/api/anthropic"
              }
            ],
            "models": [],
            "catalog": "zhipuai",
            "noList": false,
            "keyOptional": false,
            "modelRoutes": [
              {
                "pattern": "*claude*",
                "api": "anthropic-messages"
              }
            ],
            "only": []
          },
          {
            "id": "coding",
            "name": "Coding Plan",
            "bases": [
              {
                "api": "openai-completions",
                "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4"
              },
              {
                "api": "openai-responses",
                "baseURL": "https://open.bigmodel.cn/api/v1"
              },
              {
                "api": "anthropic-messages",
                "baseURL": "https://open.bigmodel.cn/api/anthropic"
              }
            ],
            "models": [],
            "catalog": "zhipuai",
            "noList": false,
            "keyOptional": false,
            "modelRoutes": [
              {
                "pattern": "*claude*",
                "api": "anthropic-messages"
              }
            ],
            "only": []
          }
        ],
        "connectionManaged": true,
        "apiKeyAuth": "bearer"
      }
    }
  }
}
