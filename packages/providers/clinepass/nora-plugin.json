{
  "apiVersion": 2,
  "id": "clinepass",
  "name": "ClinePass",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "https://api.cline.bot/api/v1",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "Cline API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "label": "API key",
              "type": "password",
              "required": true
            }
          ]
        }
      ],
      "models": [
        {
          "id": "cline-pass/glm-5.3"
        },
        {
          "id": "cline-pass/glm-5.3-flash"
        },
        {
          "id": "cline-pass/kimi-k3"
        },
        {
          "id": "cline-pass/deepseek-v4-pro"
        },
        {
          "id": "cline-pass/deepseek-v4.1-flash"
        },
        {
          "id": "cline-pass/mimo-v2.5"
        },
        {
          "id": "cline-pass/mimo-v2.5-pro"
        },
        {
          "id": "cline-pass/minimax-m3"
        },
        {
          "id": "cline-pass/muse-spark-1.3-contributor"
        },
        {
          "id": "cline-pass/qwen3.8-max"
        },
        {
          "id": "cline-pass/qwen3.7-max"
        },
        {
          "id": "cline-pass/qwen3.7-plus"
        }
      ],
      "config": {
        "persistent": true,
        "options": [
          {
            "id": "pinUpstream",
            "type": "boolean",
            "label": "DeepSeek and GLM models only from their makers' own APIs",
            "description": "A DeepSeek request goes only to DeepSeek and a GLM request only to Z.ai, preserving their prompt cache. The request fails when that API cannot serve it.",
            "default": false,
            "preserveUnset": true
          }
        ],
        "authTimeoutMs": 600000,
        "only": [
          "cline-pass/"
        ]
      }
    }
  }
}
