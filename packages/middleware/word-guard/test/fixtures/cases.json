[
  { "name": "a listed word in the last user text is turned away",
    "options": { "words": ["Project-X"] },
    "request": { "model": "m", "messages": [{ "role": "user", "content": [{ "type": "text", "text": "tell me about project-x" }] }] },
    "reject": { "status": 400, "message": "project-x" } },
  { "name": "a custom message",
    "options": { "words": ["secret"], "message": "No." },
    "request": { "model": "m", "messages": [{ "role": "user", "content": "a secret" }] },
    "reject": { "status": 400, "message": "No." } },
  { "name": "clean text passes untouched",
    "options": { "words": ["project-x"] },
    "request": { "model": "m", "messages": [{ "role": "user", "content": "hello" }] } },
  { "name": "tool results and earlier turns aren't read with check last",
    "options": { "words": ["project-x"] },
    "request": { "model": "m", "messages": [
      { "role": "user", "content": "project-x" },
      { "role": "assistant", "content": [{ "type": "tool_use", "id": "t", "name": "Read", "input": {} }] },
      { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "t", "content": "project-x" }] },
      { "role": "user", "content": [{ "type": "text", "text": "go on" }] }] } },
  { "name": "check all reads earlier turns",
    "options": { "words": ["project-x"], "check": "all" },
    "request": { "model": "m", "messages": [{ "role": "user", "content": "project-x" }, { "role": "user", "content": "go on" }] },
    "reject": { "status": 400 } },
  { "name": "mask swaps words and patterns",
    "options": { "words": ["acme"], "patterns": ["\\b\\d{3}-\\d{4}\\b"], "action": "mask", "mask": "[x]" },
    "request": { "model": "m", "messages": [{ "role": "user", "content": [{ "type": "text", "text": "ACME at 555-1234" }, { "type": "image", "source": {} }] }] },
    "expect_request": { "model": "m", "messages": [{ "role": "user", "content": [{ "type": "text", "text": "[x] at [x]" }, { "type": "image", "source": {} }] }] } },
  { "name": "Chat: string content",
    "ctx": { "protocol": "chat" },
    "options": { "words": ["acme"], "action": "mask" },
    "request": { "model": "m", "messages": [{ "role": "system", "content": "acme" }, { "role": "user", "content": "acme!" }] },
    "expect_request": { "model": "m", "messages": [{ "role": "system", "content": "acme" }, { "role": "user", "content": "***!" }] } },
  { "name": "Responses: input_text",
    "ctx": { "protocol": "responses" },
    "options": { "words": ["acme"] },
    "request": { "model": "m", "input": [{ "role": "user", "content": [{ "type": "input_text", "text": "acme" }] }] },
    "reject": { "status": 400 } },
  { "name": "Gemini: parts",
    "ctx": { "protocol": "gemini" },
    "options": { "words": ["acme"], "action": "mask" },
    "request": { "contents": [{ "role": "user", "parts": [{ "text": "acme" }] }] },
    "expect_request": { "contents": [{ "role": "user", "parts": [{ "text": "***" }] }] } },
  { "name": "replies masked in Anthropic and Chat streams",
    "options": { "words": ["acme"], "action": "mask", "replies": true },
    "events": [
      { "event": "content_block_delta", "data": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "Acme Inc" } } },
      { "data": { "choices": [{ "index": 0, "delta": { "content": "acme" } }] } },
      { "event": "message_stop", "data": { "type": "message_stop" } }],
    "expect_events": [
      { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "*** Inc" } },
      { "choices": [{ "index": 0, "delta": { "content": "***" } }] },
      { "type": "message_stop" }] },
  { "name": "a whole reply masked",
    "options": { "words": ["acme"], "action": "mask", "replies": true },
    "response": { "content": [{ "type": "text", "text": "acme" }, { "type": "tool_use", "input": { "q": "acme" } }] },
    "expect_response": { "content": [{ "type": "text", "text": "***" }, { "type": "tool_use", "input": { "q": "acme" } }] } },
  { "name": "replies untouched unless asked",
    "options": { "words": ["acme"], "action": "mask" },
    "response": { "content": [{ "type": "text", "text": "acme" }] } },
  { "name": "a Gemini reply is masked in its own place, streamed and whole",
    "ctx": { "protocol": "gemini" },
    "options": { "words": ["acme"], "action": "mask", "replies": true },
    "events": [
      { "data": { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "acme Inc" }] } }] } },
      { "data": { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "and acme" }, { "functionCall": { "name": "acme", "args": {} } }] }, "finishReason": "STOP" }] } }],
    "expect_events": [
      { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "*** Inc" }] } }] },
      { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "and ***" }, { "functionCall": { "name": "acme", "args": {} } }] }, "finishReason": "STOP" }] }],
    "response": { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "acme", "thought": true }, { "text": "acme" }] } }] },
    "expect_response": { "candidates": [{ "content": { "role": "model", "parts": [{ "text": "***", "thought": true }, { "text": "***" }] } }] } }
]
