{
  "apiVersion": 1,
  "id": "kiro",
  "name": "Kiro",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "anthropic-messages",
  "baseURL": "https://runtime.us-east-1.kiro.dev",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with Google, GitHub, AWS Builder ID or IAM Identity Center"
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "Kiro API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "label": "Kiro API key (ksk_\u2026)",
          "type": "password",
          "required": true
        }
      ]
    },
    {
      "id": "cliSource",
      "type": "oauth",
      "label": "Use a selected Kiro CLI account database",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Kiro CLI data.sqlite3 path",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "id": "ideSource",
      "type": "oauth",
      "label": "Use a selected Kiro IDE account file",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Kiro IDE kiro-auth-token.json path",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "id": "magpieSource",
      "type": "oauth",
      "label": "Use an existing Kiro account in Magpie",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "label": "Magpie plugin-auth.json path",
          "type": "text",
          "required": true
        },
        {
          "id": "sourceAccount",
          "key": "sourceAccount",
          "label": "Saved account slot",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "models": [
    {
      "id": "auto",
      "name": "Auto",
      "reasoning": true
    }
  ],
  "config": {
    "catalog": "",
    "keyProvider": "kiro",
    "oauthProvider": "kiro",
    "description": "Connect Kiro with Google, GitHub, AWS Builder ID, IAM Identity Center or an API key. Existing Kiro CLI, Kiro IDE and Magpie logins are discovered automatically and renewed in their original source."
  },
  "localSignIns": [
    {
      "method": "cliSource",
      "label": "Kiro CLI",
      "paths": [
        "~/Library/Application Support/kiro-cli/data.sqlite3"
      ],
      "inputs": {
        "sourcePath": "{path}"
      }
    },
    {
      "method": "ideSource",
      "label": "Kiro IDE",
      "paths": [
        "~/.aws/sso/cache/kiro-auth-token.json"
      ],
      "inputs": {
        "sourcePath": "{path}"
      }
    },
    {
      "method": "magpieSource",
      "label": "Magpie",
      "paths": [
        "~/.config/magpie/plugin-auth.json"
      ],
      "inputs": {
        "sourcePath": "{path}"
      }
    }
  ]
}
