{
  "apiVersion": 2,
  "id": "qwen-decision",
  "name": "Qwen Decision Model",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "systemone",
      "baseURL": "https://maas.qianwenaiapi.com/compatible-mode/v1",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "Qwen AI platform API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "API key",
              "required": true
            },
            {
              "id": "endpoint",
              "key": "endpoint",
              "type": "text",
              "label": "Decision endpoint (optional)",
              "required": false
            }
          ]
        }
      ],
      "models": [
        {
          "id": "decision-model-preview",
          "name": "Decision model (preview)",
          "api": "systemone",
          "contextWindow": 65536,
          "input": [
            "text"
          ],
          "info": {
            "decision": true,
            "chat": false,
            "toolCalling": false,
            "catalogSource": "preset",
            "pricingKnown": false
          }
        }
      ],
      "config": {
        "persistent": true,
        "catalog": "",
        "keyProvider": "qwen-decision-api-key",
        "operations": [
          "decision"
        ],
        "operationsAuthMethods": {
          "decision": [
            "api",
            "apiKey"
          ]
        }
      }
    }
  }
}
