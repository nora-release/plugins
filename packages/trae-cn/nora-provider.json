{
  "apiVersion": 1,
  "id": "trae-cn",
  "name": "Trae CN",
  "version": "1.2.0",
  "runtime": {
    "type": "native",
    "entry": "provider"
  },
  "api": "openai-completions",
  "baseURL": "https://trae-api-cn.mchost.guru/v1",
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with Trae CN"
    },
    {
      "id": "oauth-client",
      "type": "oauth",
      "label": "Sign in and use this Trae CN installation for daily credits",
      "prompts": [
        {
          "key": "path",
          "type": "text",
          "label": "Trae CN storage file (optional)",
          "placeholder": "\u2026/User/globalStorage/storage.json"
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "authTimeoutMs": 600000,
    "accountActions": [
      "checkin"
    ],
    "initialResponseTimeoutMs": 240000
  }
}
