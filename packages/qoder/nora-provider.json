{
  "apiVersion": 1,
  "id": "qoder",
  "name": "Qoder",
  "version": "1.2.0",
  "runtime": {
    "type": "native",
    "entry": "provider"
  },
  "api": "openai-completions",
  "baseURL": "https://api3.qoder.sh",
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with Qoder"
    },
    {
      "id": "pat",
      "type": "oauth",
      "label": "Sign in with Qoder PAT",
      "prompts": [
        {
          "key": "pat",
          "type": "password",
          "label": "Personal Access Token",
          "placeholder": "pt-..."
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "accountActions": [
      "checkin"
    ],
    "authTimeoutMs": 1050000
  }
}
