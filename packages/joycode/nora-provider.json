{
  "apiVersion": 1,
  "id": "joycode",
  "name": "JoyCode",
  "version": "1.2.0",
  "runtime": {
    "type": "native",
    "entry": "provider"
  },
  "api": "openai-completions",
  "baseURL": "https://api-ai.jd.com/v1",
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with JoyCode"
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "JoyCode ptKey",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "ptKey",
          "required": true
        },
        {
          "id": "tenant",
          "key": "tenant",
          "type": "text",
          "label": "Tenant",
          "required": false
        }
      ]
    }
  ],
  "models": [
    {
      "id": "JoyAI-Code-1.6",
      "name": "JoyAI Code 1.6",
      "contextWindow": 200000,
      "maxTokens": 64000,
      "input": [
        "text"
      ],
      "reasoning": false,
      "info": {
        "toolCalling": true,
        "chat": true
      }
    },
    {
      "id": "GLM-5.3-agent",
      "name": "GLM 5.3",
      "contextWindow": 200000,
      "maxTokens": 64000,
      "input": [
        "text"
      ],
      "reasoning": true,
      "info": {
        "toolCalling": true,
        "chat": true
      }
    },
    {
      "id": "Kimi-K2.6-agent",
      "name": "Kimi K2.6",
      "contextWindow": 200000,
      "maxTokens": 64000,
      "input": [
        "text",
        "image"
      ],
      "reasoning": true,
      "info": {
        "toolCalling": true,
        "chat": true
      }
    },
    {
      "id": "MiniMax-M3-agent",
      "name": "MiniMax M3",
      "contextWindow": 200000,
      "maxTokens": 64000,
      "input": [
        "text",
        "image"
      ],
      "reasoning": true,
      "info": {
        "toolCalling": true,
        "chat": true
      }
    },
    {
      "id": "Doubao-Seed-2.0-pro-agent",
      "name": "Doubao Seed 2.0 Pro",
      "contextWindow": 200000,
      "maxTokens": 64000,
      "input": [
        "text",
        "image"
      ],
      "reasoning": true,
      "info": {
        "toolCalling": true,
        "chat": true
      }
    }
  ],
  "config": {
    "maxConcurrency": 4,
    "ownClient": true,
    "authTimeoutMs": 660000
  }
}
