{
  "apiVersion": 1,
  "id": "cloudflare-jev",
  "name": "Cloudflare Workers AI · Jev, Clef",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "systemone",
  "baseURL": "https://api.cloudflare.com/client/v4",
  "authMethods": [
    {
      "id": "apiKey",
      "type": "api",
      "label": "Workers AI API token",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "API key",
          "required": true
        },
        {
          "id": "accountId",
          "key": "accountId",
          "type": "text",
          "label": "Cloudflare account ID (optional)",
          "required": false
        },
        {
          "id": "endpoint",
          "key": "endpoint",
          "type": "text",
          "label": "Decision endpoint (optional)",
          "required": false
        }
      ]
    }
  ],
  "models": [
    {
      "id": "typesafe/jev",
      "name": "Jev",
      "api": "systemone",
      "contextWindow": 32000,
      "input": [
        "text"
      ],
      "info": {
        "decision": true,
        "chat": false,
        "toolCalling": false,
        "catalogSource": "preset",
        "pricingKnown": false
      }
    },
    {
      "id": "@cf/cloudflare/clef",
      "name": "Clef",
      "api": "systemone",
      "contextWindow": 65536,
      "input": [
        "text",
        "image",
        "video"
      ],
      "info": {
        "decision": true,
        "chat": false,
        "toolCalling": false,
        "catalogSource": "preset",
        "pricingKnown": false
      }
    },
    {
      "id": "@cf/cloudflare/clef-flash",
      "name": "Clef Flash",
      "api": "systemone",
      "contextWindow": 65536,
      "input": [
        "text",
        "image",
        "video"
      ],
      "info": {
        "decision": true,
        "chat": false,
        "toolCalling": false,
        "catalogSource": "preset",
        "pricingKnown": false
      }
    }
  ],
  "config": {
    "persistent": true,
    "catalog": "",
    "keyProvider": "cloudflare-jev-api-key",
    "operations": [
      "decision"
    ],
    "operationsAuthMethods": {
      "decision": [
        "api",
        "apiKey"
      ]
    }
  }
}
