{
  "apiVersion": 2,
  "id": "param-override",
  "name": "Param Override",
  "version": "1.2.0",
  "summary": "Set, delete, move or rewrite request fields with optional conditions.",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "middleware": {
      "version": 1,
      "request": true,
      "options": {
        "operations": [
          {
            "path": "max_tokens",
            "mode": "set",
            "value": 32000,
            "conditions": [
              {
                "path": "max_tokens",
                "mode": "gt",
                "value": 32000
              }
            ]
          },
          {
            "path": "temperature",
            "mode": "delete",
            "conditions": [
              {
                "path": "model",
                "mode": "contains",
                "value": "reasoner"
              }
            ]
          }
        ]
      }
    }
  }
}
