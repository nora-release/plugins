{
  "apiVersion": 1,
  "id": "cursor",
  "name": "Cursor",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://api2.cursor.sh/nora/v1",
  "authMethods": [
    {
      "id": "browser",
      "type": "oauth",
      "label": "Sign in to Cursor"
    },
    {
      "id": "apiKey",
      "type": "api",
      "label": "Cursor API key",
      "fields": [
        {
          "id": "apiKey",
          "key": "apiKey",
          "type": "password",
          "label": "Cursor API key",
          "required": true
        }
      ]
    },
    {
      "id": "cliSource",
      "type": "oauth",
      "label": "Use a selected cursor-agent auth.json",
      "fields": [
        {
          "id": "sourcePath",
          "key": "sourcePath",
          "type": "text",
          "label": "cursor-agent auth.json path",
          "required": true
        }
      ]
    },
    {
      "id": "keychainSource",
      "type": "oauth",
      "label": "Use cursor-agent's macOS Keychain sign-in"
    }
  ],
  "models": [],
  "config": {
    "catalog": "",
    "description": "Cursor subscriptions through Cursor Agent Connect. Only the tools advertised by Nora may run.",
    "authTimeoutMs": 690000
  }
}
