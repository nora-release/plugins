{
  "apiVersion": 2,
  "id": "openrouter",
  "name": "OpenRouter",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "https://openrouter.ai/api/v1",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "API key",
              "required": true
            }
          ]
        }
      ],
      "config": {
        "modelMetadata": true,
        "connectionOptions": true,
        "catalog": "openrouter",
        "keyProvider": "openrouter",
        "legacy": {
          "providerID": "openrouter",
          "keyProvider": "openrouter",
          "oauthProvider": null,
          "credentialProvider": "apiKey"
        },
        "modelDiscovery": {
          "defaultBaseURL": "https://openrouter.ai/api/v1",
          "bases": [
            {
              "api": "openai-completions",
              "baseURL": "https://openrouter.ai/api/v1"
            }
          ]
        },
        "headerHints": [
          "HTTP-Referer",
          "X-OpenRouter-Title"
        ]
      }
    }
  }
}
