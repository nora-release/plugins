{
  "apiVersion": 2,
  "id": "amazon-bedrock",
  "name": "Amazon Bedrock",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "us-east-1",
      "authMethods": [
        {
          "id": "apiKey",
          "type": "api",
          "label": "Bedrock API key",
          "fields": [
            {
              "id": "apiKey",
              "key": "apiKey",
              "type": "password",
              "label": "Bedrock API key",
              "required": true
            },
            {
              "id": "region",
              "key": "region",
              "type": "text",
              "label": "AWS region",
              "placeholder": "us-east-1"
            }
          ]
        },
        {
          "id": "aws",
          "type": "api",
          "label": "AWS credentials (Converse)",
          "fields": [
            {
              "id": "accessKeyId",
              "key": "accessKeyId",
              "type": "text",
              "label": "Access key ID",
              "required": true
            },
            {
              "id": "secretAccessKey",
              "key": "secretAccessKey",
              "type": "password",
              "label": "Secret access key",
              "required": true
            },
            {
              "id": "sessionToken",
              "key": "sessionToken",
              "type": "password",
              "label": "Session token",
              "required": false
            },
            {
              "id": "region",
              "key": "region",
              "type": "text",
              "label": "AWS region",
              "placeholder": "us-east-1"
            }
          ]
        }
      ],
      "models": [
        {
          "id": "global.anthropic.claude-opus-5-5"
        },
        {
          "id": "global.anthropic.claude-sonnet-5-5"
        },
        {
          "id": "global.anthropic.claude-sonnet-5"
        },
        {
          "id": "global.anthropic.claude-opus-5"
        },
        {
          "id": "global.anthropic.claude-fable-5-1"
        },
        {
          "id": "global.anthropic.claude-opus-4-8"
        },
        {
          "id": "global.anthropic.claude-opus-4-7"
        },
        {
          "id": "global.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "id": "global.openai.gpt-6-astra"
        },
        {
          "id": "global.openai.gpt-6-sol"
        },
        {
          "id": "global.openai.gpt-6-luna"
        },
        {
          "id": "openai.gpt-oss-120b-1:0"
        },
        {
          "id": "openai.gpt-oss-20b-1:0"
        },
        {
          "id": "qwen.qwen3-coder-480b-a35b-v1:0"
        },
        {
          "id": "deepseek.v3.2"
        },
        {
          "id": "moonshotai.kimi-k2.5"
        },
        {
          "id": "zai.glm-5"
        },
        {
          "id": "minimax.minimax-m2.5"
        }
      ],
      "config": {
        "keyProvider": "amazon-bedrock",
        "catalog": "amazon-bedrock",
        "connectionManaged": true,
        "modelDiscovery": {
          "noList": true
        },
        "endpointKind": "region"
      }
    }
  }
}
