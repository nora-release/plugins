{
  "apiVersion": 2,
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "version": "1.2.0",
  "summary": "Connect Gemini CLI with Google sign-in. The current Gemini CLI login is discovered automatically and renewed in its original file.",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "google-generative-ai",
      "baseURL": "https://cloudcode-pa.googleapis.com",
      "authMethods": [
        {
          "id": "oauth",
          "type": "oauth",
          "label": "Sign in to Gemini CLI",
          "fields": [
            {
              "id": "project",
              "key": "project",
              "type": "text",
              "label": "Google Cloud project (if required)",
              "required": false
            }
          ]
        },
        {
          "id": "geminiCLI",
          "type": "oauth",
          "label": "Use the current Gemini CLI account"
        },
        {
          "id": "source",
          "type": "oauth",
          "label": "Use an explicitly selected Google account file",
          "fields": [
            {
              "id": "sourcePath",
              "key": "sourcePath",
              "type": "text",
              "label": "Account JSON file path",
              "required": true
            },
            {
              "id": "project",
              "key": "project",
              "type": "text",
              "label": "Google Cloud project (if required)",
              "required": false
            }
          ]
        }
      ],
      "config": {
        "catalog": "",
        "keyProvider": "gemini-cli",
        "oauthProvider": "gemini-cli",
        "modelDiscovery": {
          "defaultBaseURL": "https://cloudcode-pa.googleapis.com",
          "bases": [
            {
              "api": "google-generative-ai",
              "baseURL": "https://cloudcode-pa.googleapis.com"
            }
          ]
        },
        "accountImport": {
          "formats": [
            "auto",
            "google-account",
            "antigravity-manager",
            "cli-proxy",
            "refresh-token",
            "nora-account",
            "magpie-login"
          ],
          "refreshesTokens": true,
          "maxEntries": 200,
          "maxBytes": 4194304
        }
      },
      "localSignIns": [
        {
          "method": "geminiCLI",
          "label": "Gemini CLI",
          "paths": [
            "~/.gemini/oauth_creds.json"
          ]
        }
      ]
    }
  }
}
