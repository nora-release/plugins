{
  "apiVersion": 1,
  "id": "minimax-code-global",
  "name": "MiniMax Code Global",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "anthropic-messages",
  "baseURL": "https://agent.minimax.io/mavis/api/v1/llm/v1",
  "aliases": [],
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "MiniMax Code account"
    }
  ],
  "models": [],
  "config": {
    "persistent": true,
    "accountActions": [
      "checkin"
    ],
    "authTimeoutMs": 900000,
    "accountAutomation": {
      "version": 1,
      "checkin": {
        "method": "checkin",
        "statusMethod": "checkinStatus",
        "timeZone": "Asia/Shanghai",
        "authMethods": [
          "oauth"
        ]
      }
    }
  }
}
