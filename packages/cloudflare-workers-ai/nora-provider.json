{
  "apiVersion": 1,
  "id": "cloudflare-workers-ai",
  "name": "Cloudflare Workers AI",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
  "aliases": [],
  "authMethods": [
    {
      "id": "apiKey",
      "type": "api",
      "label": "Cloudflare API token",
      "fields": [
        {
          "id": "token",
          "key": "token",
          "type": "password",
          "label": "API token",
          "required": true
        },
        {
          "id": "accountId",
          "key": "accountId",
          "type": "text",
          "label": "Account ID",
          "placeholder": "32 hexadecimal characters"
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "connectionOptions": false,
    "catalog": "cloudflare-workers-ai",
    "keyProvider": "cloudflare-workers-ai",
    "legacy": {
      "providerID": "cloudflare-workers-ai",
      "keyProvider": "cloudflare-workers-ai",
      "oauthProvider": null,
      "credentialProvider": "apiKey"
    },
    "accountId": "",
    "baseTemplate": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
    "discoveryTTLMs": 3600000,
    "maxConcurrency": 3
  }
}
