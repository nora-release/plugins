{
  "apiVersion": 1,
  "id": "reserve",
  "name": "Reserve",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "gateway-middleware",
  "authMethods": [],
  "models": [],
  "config": {
    "gatewayMiddleware": {
      "version": 1,
      "strategies": [
        "ceiling",
        "accounts-first"
      ]
    },
    "middlewareOptions": {
      "ceiling": 80
    },
    "description": "Keep account capacity in reserve or prefer subscriptions before pay-per-token accounts."
  }
}
