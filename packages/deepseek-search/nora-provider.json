{
  "apiVersion": 1,
  "id": "deepseek-search",
  "name": "DeepSeek Search",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-completions",
  "baseURL": "https://api.deepseek.com",
  "authMethods": [
    {
      "id": "apiKey",
      "type": "api",
      "label": "API key",
      "fields": [
        {
          "key": "apiKey",
          "type": "password",
          "label": "API key",
          "required": true
        }
      ]
    }
  ],
  "models": [],
  "config": {
    "connectionOptions": true,
    "searchAPI": {
      "version": 1,
      "order": 5,
      "keyOptional": false,
      "requiresBaseURL": false
    },
    "sdkCapabilities": {
      "webSearch": 1
    },
    "keyOptional": false,
    "options": [
      {
        "id": "searchKeysInOrder",
        "type": "boolean",
        "label": "Use API keys in order",
        "description": "Use the first available API key; otherwise searches take turns between keys.",
        "default": false
      }
    ]
  }
}
