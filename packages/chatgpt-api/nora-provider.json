{
  "apiVersion": 1,
  "id": "chatgpt-api",
  "name": "ChatGPT API",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider",
    "type": "native"
  },
  "api": "openai-responses",
  "baseURL": "https://api.openai.com/v1",
  "authMethods": [
    {
      "id": "oauth",
      "type": "oauth",
      "label": "Sign in with ChatGPT"
    }
  ],
  "models": [],
  "config": {
    "keyProvider": "chatgpt-api",
    "connectionManaged": true,
    "subscriptionAccounts": true,
    "ownClient": true,
    "accountRevocation": {
      "version": 1
    },
    "sdkCapabilities": {
      "accountRevocation": 1
    },
    "supplementalCatalogs": [
      {
        "provider": "openai",
        "api": "chatgpt-codex",
        "as": "codex"
      }
    ]
  }
}
