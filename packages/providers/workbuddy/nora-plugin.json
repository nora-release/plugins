{
  "apiVersion": 2,
  "id": "workbuddy",
  "name": "WorkBuddy",
  "version": "1.2.0",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "openai-completions",
      "baseURL": "https://copilot.tencent.com/v2",
      "authMethods": [
        {
          "id": "oauth",
          "type": "oauth",
          "label": "Sign in with WorkBuddy"
        },
        {
          "id": "desktop",
          "type": "oauth",
          "label": "Use WorkBuddy desktop sign-in (read only)"
        }
      ],
      "config": {
        "sourceAuthMethods": [
          {
            "id": "desktop",
            "type": "oauth",
            "label": "Use WorkBuddy desktop sign-in (read only)"
          }
        ],
        "authTimeoutMs": 420000,
        "accountAutomation": {
          "version": 1,
          "checkin": {
            "method": "checkin",
            "statusMethod": "checkinStatus",
            "timeZone": "Asia/Shanghai",
            "authMethods": [
              "oauth",
              "desktop"
            ]
          }
        },
        "accountActions": [
          "checkin"
        ],
        "ownSearch": {
          "version": 1,
          "manual": false
        },
        "sdkCapabilities": {
          "webSearch": 1
        }
      },
      "localSignIns": [
        {
          "method": "desktop",
          "label": "WorkBuddy",
          "paths": [
            "~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/workbuddy-desktop.info"
          ]
        }
      ]
    }
  }
}
