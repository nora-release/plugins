{
  "apiVersion": 2,
  "id": "antigravity",
  "name": "Antigravity",
  "version": "1.2.0",
  "summary": "Connect Antigravity with Google sign-in or an explicitly selected read-only account file.",
  "runtime": {
    "entry": "provider"
  },
  "contributes": {
    "provider": {
      "api": "google-generative-ai",
      "baseURL": "https://daily-cloudcode-pa.googleapis.com",
      "authMethods": [
        {
          "id": "oauth",
          "type": "oauth",
          "label": "Sign in to Antigravity",
          "fields": [
            {
              "id": "project",
              "key": "project",
              "type": "text",
              "label": "Google Cloud project (if required)",
              "required": false
            }
          ]
        },
        {
          "id": "source",
          "type": "oauth",
          "label": "Use an explicitly selected Google account file",
          "fields": [
            {
              "id": "sourcePath",
              "key": "sourcePath",
              "type": "text",
              "label": "Account JSON file path",
              "required": true
            },
            {
              "id": "project",
              "key": "project",
              "type": "text",
              "label": "Google Cloud project (if required)",
              "required": false
            }
          ]
        }
      ],
      "config": {
        "catalog": "",
        "keyProvider": "antigravity",
        "oauthProvider": "antigravity",
        "modelDiscovery": {
          "defaultBaseURL": "https://daily-cloudcode-pa.googleapis.com",
          "bases": [
            {
              "api": "google-generative-ai",
              "baseURL": "https://daily-cloudcode-pa.googleapis.com"
            }
          ]
        },
        "accountImport": {
          "formats": [
            "auto",
            "google-account",
            "antigravity-manager",
            "cli-proxy",
            "refresh-token",
            "nora-account",
            "magpie-login"
          ],
          "refreshesTokens": true,
          "maxEntries": 200,
          "maxBytes": 4194304
        }
      }
    }
  }
}
