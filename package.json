{
  "name": "@nora/plugin-catalog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@nora/plugin-kit": "github:nora-release/plugin-kit#v0.8.0"
  },
  "scripts": {
    "generate": "node node_modules/@nora/plugin-kit/scripts/plugin-marketplace.mjs generate --registry registry.json --output marketplace.json",
    "check": "node node_modules/@nora/plugin-kit/scripts/plugin-marketplace.mjs validate --registry registry.json --catalog marketplace.json --verify-downloads"
  }
}
